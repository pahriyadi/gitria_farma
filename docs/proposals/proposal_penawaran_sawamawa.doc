                <td class="text-right font-bold">Rp 500.000,-</td>
                <td>Pemeliharaan berkala, backup database harian terenkripsi ke Cloud Storage</td>
            </tr>
            <tr style="background-color: #fefce8;">
                <td colspan="2" class="text-right font-bold">TOTAL BIAYA PERPANJANGAN TAHUNAN:</td>
                <td colspan="2" class="font-bold" style="color: #b45309;">Rp 1.500.000 - Rp 2.000.000,- / Tahun</td>
            </tr>
